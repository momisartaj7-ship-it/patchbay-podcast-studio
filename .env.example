# Copy this file to .env and fill these in to enable durable cloud storage
# for recordings. If left unset, the app falls back to saving on local disk
# (fine for testing, NOT durable on most free hosting).
#
# Works with any S3-compatible provider. Recommended: Backblaze B2 — free
# 10GB tier, no credit card required. Values below are for B2; see the
# README for exact steps and for using Cloudflare R2 instead.

# Example for Backblaze B2:
#   STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   STORAGE_REGION=us-west-004
#   STORAGE_ACCESS_KEY_ID=<your keyID>
#   STORAGE_SECRET_ACCESS_KEY=<your applicationKey>
#   STORAGE_BUCKET_NAME=<your bucket name>

STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
